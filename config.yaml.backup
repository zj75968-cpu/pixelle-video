phone_agent:
  url: ''
  token: pixelle_secure_agent_token_2026
  chunk_size_mb: 5
  timeout_push: 120
distribution_mode: legacy
distribution:
  mode: phone_agent
  result_wait_seconds: 240
  result_poll_interval_seconds: 5
  max_retry: 2
  batch_size: 3
  send_interval_seconds: 2
  mobile_devices_config: config/devices.yaml
  remote_paths:
